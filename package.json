{
  "name": "qivra",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/website"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @qivra/website",
    "build": "npm run build --workspace @qivra/website",
    "start": "npm run start --workspace @qivra/website",
    "typecheck": "npm run typecheck --workspace @qivra/website",
    "test:e2e": "npm run test:e2e --workspace @qivra/website",
    "check": "npm run typecheck && npm run build"
  }
}
